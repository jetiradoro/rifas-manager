# Entorno compartido entre API y app
NODE_ENV=development

# Hostnames para proxy inverso externo


MAP_UUID=1000

## APP
API_VIRTUAL_HOST=api.rifas.loc
APP_VIRTUAL_HOST=app.rifas.loc

## API 
API_NAME=rifas-api
APP_NAME=rifas-app

## DOCS
DOCS_VIRTUAL_HOST=docs.rifas.loc

## BUILD (dev = código por volumen + override | prod = imagen compilada)
APP_TARGET=dev
API_TARGET=dev
# Producción: NODE_ENV=production, APP_TARGET=prod, API_TARGET=prod
# y desplegar con: docker compose -f docker-compose.yml up -d --build
